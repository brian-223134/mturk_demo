# frontend 의 nginx 설정. 공식 nginx 이미지가 시작할 때 ${API_UPSTREAM} 을 환경 변수 값으로 바꿔 /etc/nginx/conf.d/default.conf 에 쓴다.
# $uri, $host 같은 nginx 변수는 환경 변수가 아니므로 그대로 남는다.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # REST 와 agent job API 는 backend 로 넘긴다. 브라우저는 같은 origin 만 부르므로 CORS 설정이 필요 없다.
    # 주소를 변수에 담아 요청이 올 때 찾게 한다. 그러지 않으면 nginx 가 시작할 때 upstream 이름을 찾지 못하면
    # (backend 없이 --no-deps 로 띄울 때) 컨테이너가 아예 뜨지 않는다. 127.0.0.11 은 Docker 내장 DNS 다.
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # agent job 의 원본 파일과 batch 게시의 CSV 전체가 body 로 온다. 셀 하나가 100KB 를 넘을 수 있다.
        client_max_body_size 256m;
        # agent job 은 오래 걸릴 수 있다 (LLM 호출, 큰 원본).
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 빌드 산출물이 아니라 소스 그대로라 파일 이름에 해시가 없다. 그래서 html, js, css 모두 캐시하지 않는다.
    # SPA 라우팅: /manage/batch-1000001/review 같은 경로에서 새로고침해도 앱이 뜬다.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
