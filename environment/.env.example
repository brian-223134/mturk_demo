# agent가 읽는 환경 파일의 예시다. 이 파일을 .env 로 복사해 채운다. .env 는 gitignore 되어 저장소에 들어가지 않는다.
# 비밀(API 키)은 여기에만 둔다. 모델 설정(environment/models/*.yaml)에는 키를 적지 않는다.

# OpenRouter API 키. 환경변수 OPENROUTER_KEY 가 있으면 그것을 먼저 쓴다.
OPENROUTER_KEY=

# 쓸 모델 설정. environment/models/ 안의 파일 이름(확장자 없이)이거나 .yaml 파일 경로다.
# 지금 있는 것: default (gpt-oss-120b), qwen3-235b, deepseek-v3.2. 명령의 --model-config 가 있으면 그것이 우선한다.
AGENT_MODEL=default

# 실제 OpenRouter 호출(크레딧 소모)의 허용 여부. 1 이면 콘솔(backend)과 agent 명령이 호출을 허용한다.
# 셸에서 AGENT_ALLOW_API 를 주면 그 값이 앞선다 (0 을 주면 여기가 1 이어도 막는다). 바꾼 뒤에는 backend 를 다시 띄운다.
# 콘솔에서는 여기를 1 로 둬도 job 마다 화면의 "Allow API calls (uses credits)" 를 체크해야 호출한다.
AGENT_ALLOW_API=0

# 콘솔(backend)에서 동시에 도는 agent job 수. 비워 두면 3 이다. Generate from raw data 는 후보 3개를 한꺼번에 만들므로
# 3 보다 작게 하면 후보가 차례를 기다린다. 바꾼 뒤에는 backend 를 다시 띄운다.
# AGENT_JOB_WORKERS=3
